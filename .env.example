# ClinicOS Environment Configuration
# Copy this file to .env and fill in the actual values for your environment

# ==========================================
# Database Configuration (PostgreSQL)
# ==========================================
DB_URL=jdbc:postgresql://localhost:5432/clinicos_db
DB_USERNAME=clinicos_user
DB_PASSWORD=your-secure-db-password-here
DB_POOL_SIZE=5
DB_MIN_IDLE=2

# ==========================================
# JWT Configuration
# ==========================================
# Generate a strong secret key (minimum 32 characters)
# For Linux: openssl rand -base64 32
# For Linux/Mac: openssl rand -base64 32
# For Windows PowerShell: [Convert]::ToBase64String((1..32 | ForEach-Object { [byte]$(Get-Random -Maximum 256) }))
JWT_SECRET=your-jwt-secret-key-min-32-chars-generate-strong-key
JWT_EXPIRATION=86400000

# ==========================================
# Application Environment
# ==========================================
# Values: local, dev, prod
SPRING_PROFILES_ACTIVE=prod

# ==========================================
# Server Configuration
# ==========================================
SERVER_PORT=8080

# ==========================================
# CORS Configuration
# ==========================================
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ==========================================
# Logging Configuration
# ==========================================
LOG_LEVEL=WARN
LOG_LEVEL_CLINICOS=INFO
LOG_FILE_PATH=/var/log/clinicos

# ==========================================
# Email/Notification Configuration
# ==========================================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-specific-password
MAIL_FROM=noreply@clinicos.health

# ==========================================
# Google OAuth Configuration
# ==========================================
# GETTING STARTED WITH GOOGLE OAUTH2
# 1. Go to https://console.cloud.google.com/
# 2. Create a new project (or use existing)
# 3. Enable Google+ API (search in APIs)
# 4. Go to Credentials > Create Credentials > OAuth Client ID
# 5. Choose "Web Application"
# 6. Add Authorized Origins:
#    - http://localhost:3000
#    - http://localhost:8080
#    - http://127.0.0.1:3000
#    - http://127.0.0.1:8080
# 7. Add Authorized Redirect URIs:
#    - http://localhost:3000
#    - http://localhost:8080
#    - http://localhost:8080/api/v1/auth/google/callback
#    - http://127.0.0.1:3000
#    - http://127.0.0.1:8080
#    - http://127.0.0.1:8080/api/v1/auth/google/callback
# 8. Copy Client ID and Secret below

GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URL=https://yourdomain.com/api/v1/auth/google/callback

# ==========================================
# GCP Cloud SQL Configuration (Optional)
# ==========================================
# Uncomment these if using Google Cloud SQL
# GCP_PROJECT_ID=your-gcp-project-id
# CLOUD_SQL_INSTANCE=your-project-id:asia-south1:clinicos-db

# ==========================================
# Encryption Configuration
# ==========================================
# For patient data encryption (optional)
PATIENT_ENCRYPTION_KEY=your-32-char-encryption-key-here

# ==========================================
# Monitoring & Observability
# ==========================================
# Enable metrics export (optional)
# MICROMETER_REGISTRY_ENABLED=true


# ClinicOS Local Development Configuration

# ==========================================
# Database Configuration (PostgreSQL)
# ==========================================
DB_URL=jdbc:postgresql://localhost:5432/clinicos_db
DB_USERNAME=clinicos_user
DB_PASSWORD=clinicos_password
DB_POOL_SIZE=5
DB_MIN_IDLE=2

# ==========================================
# JWT Configuration
# ==========================================
# Generate a strong secret key (minimum 32 characters)
# For Linux/Mac: openssl rand -base64 32
# For Windows PowerShell: [Convert]::ToBase64String((1..32 | ForEach-Object { [byte]$(Get-Random -Maximum 256) }))
JWT_SECRET=your-32-character-jwt-secret-key-minimum-here-12345
JWT_EXPIRATION=86400000

# ==========================================
# Application Environment
# ==========================================
# Values: local, dev, prod
SPRING_PROFILES_ACTIVE=local

# ==========================================
# Server Configuration
# ==========================================
SERVER_PORT=8080

# ==========================================
# CORS Configuration - CRITICAL FOR LOCAL DEVELOPMENT
# ==========================================
# IMPORTANT: Add both frontend (3000) and backend (8080) URLs
# This allows frontend to call backend API without CORS errors
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:3000,http://127.0.0.1:8080

# ==========================================
# Logging Configuration
# ==========================================
LOG_LEVEL=DEBUG
LOG_LEVEL_CLINICOS=DEBUG

# ==========================================
# Google OAuth2 Configuration
# ==========================================
# SETUP INSTRUCTIONS:
# 1. Go to https://console.cloud.google.com/
# 2. Create a new project (or use existing)
# 3. Enable Google+ API (search in APIs)
# 4. Go to Credentials > Create Credentials > OAuth Client ID
# 5. Choose "Web Application"
# 6. Add Authorized Origins (CRITICAL):
#    - http://localhost:3000
#    - http://localhost:8080
#    - http://127.0.0.1:3000
#    - http://127.0.0.1:8080
# 7. Add Authorized Redirect URIs (CRITICAL):
#    - http://localhost:3000
#    - http://localhost:8080
#    - http://localhost:8080/api/v1/auth/google/callback
#    - http://127.0.0.1:3000
#    - http://127.0.0.1:8080
#    - http://127.0.0.1:8080/api/v1/auth/google/callback
# 8. Copy Client ID and Secret below

GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/google/callback

# ==========================================
# Email/Notification Configuration (Optional)
# ==========================================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@clinicos.health

# ==========================================
# GCP Cloud SQL Configuration (Optional for local)
# ==========================================
# Only needed if using Google Cloud SQL instead of local PostgreSQL
# GCP_PROJECT_ID=your-gcp-project-id
# CLOUD_SQL_INSTANCE=your-project-id:asia-south1:clinicos-db

# ==========================================
# Encryption Configuration (Optional)
# ==========================================
# For patient data encryption
# PATIENT_ENCRYPTION_KEY=your-32-char-encryption-key-here

# ==========================================
# Monitoring & Observability
# ==========================================
# Enable metrics export (optional)
# MICROMETER_REGISTRY_ENABLED=true

